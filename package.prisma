#prisma 4.0
def package "luce-smtp" {
    str owner = "dymokomi"
    str version = "0.1.0"
    str kind = "package"
    str language = "luce-base"
    str description = "An SMTP submission client in luce-base: EHLO and its extensions, STARTTLS and implicit TLS, AUTH PLAIN/LOGIN/XOAUTH2, MAIL/RCPT/DATA with dot-stuffing, SIZE, 8BITMIME and SMTPUTF8, and every reply code kept for the caller."
    str readme = "README.md"

    def export "smtp" {
        str module = "luce_smtp.smtp"
    }

    def dependency "luce-tls" {
        str owner = "dymokomi"
        str version = "^0.1.4"
        str path = "../luce-tls"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.5"
        str path = "../luce-std"
    }
}
